# Runtime settings
APP_ENV=development
LOG_LEVEL=info

# Server settings
CROSS_VALIDATION_HTTP_ADDR=:8080
CROSS_VALIDATION_TIME_WINDOW=10s
CROSS_VALIDATION_ALERT_WINDOW=60s
CROSS_VALIDATION_DUPLICATE_WINDOW=3s
CROSS_VALIDATION_MIN_SCORE=0.35
CROSS_VALIDATION_WARNING_THRESHOLD=0.60
CROSS_VALIDATION_CRITICAL_THRESHOLD=0.80

# Redis settings
CROSS_VALIDATION_USE_REDIS=false
CROSS_VALIDATION_REDIS_ADDR=localhost:6379
CROSS_VALIDATION_REDIS_PASSWORD=
CROSS_VALIDATION_REDIS_DB=0

# PostgreSQL settings
CROSS_VALIDATION_USE_POSTGRES=false
CROSS_VALIDATION_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/cross_validation?sslmode=disable
